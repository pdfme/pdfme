# Copy to playground/.env (gitignored). Both values are read at local build time
# from that file, mode-specific .env files, or the environment. Leave them empty
# to build without Sentry. Vercel project env vars are not used.

# Auth token for the Sentry Vite plugin (playground-pdfme).
# When set, production builds emit source maps and upload them.
SENTRY_AUTH_TOKEN=

# Browser DSN, inlined as import.meta.env.VITE_SENTRY_DSN.
# When set, the playground calls Sentry.init.
VITE_SENTRY_DSN=
